rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // v4.95/v4.99 foundation: only sanitized public profile documents belong here.
    // The client does not publish them yet; v5 will enable publication after final review.
    match /publicProfiles/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // v4.69: raw daily records are NOT published here.
    // Only anonymized aggregate counts used by GLOBAL ANALYTICS are stored.
    match /analyticsContributions/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                   && request.auth.uid == userId;
    }
  }
}
