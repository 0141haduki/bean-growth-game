rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function myPlayerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // v5.0: sanitized public profiles.
    // Ownership is verified against a private mapping under the authenticated user's document.
    match /publicProfiles/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == playerId
        && request.resource.data.playerId == playerId
        && request.resource.data.keys().hasOnly([
          'schemaVersion','playerId','nickname','goal','firstRecordDate',
          'representativeHabitId','representativeHabitName','title',
          'severity','maxHeight','maxStreak','encyclopediaUnlocked',
          'updatedAt','publishedAt','appVersion'
        ]);
      allow delete: if false;
    }

    // v5.9 ranking divisions.
    match /rankingBoards/{month}/divisions/{division}/players/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == playerId
        && request.resource.data.playerId == playerId
        && request.resource.data.month == month
        && request.resource.data.division == division
        && request.resource.data.habit is string
        && request.resource.data.severity is string
        && division == ('habit-' + request.resource.data.habit + '__severity-' + request.resource.data.severity)
        && request.resource.data.currentStreak >= 0
        && request.resource.data.score >= 0
        && request.resource.data.recordRate >= 0
        && request.resource.data.recordRate <= 100;
      allow delete: if false;
    }

    match /friendRequests/{recipientPlayerId}/incoming/{senderPlayerId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == recipientPlayerId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == senderPlayerId);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == senderPlayerId
        && request.resource.data.senderPlayerId == senderPlayerId
        && request.resource.data.recipientPlayerId == recipientPlayerId
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == recipientPlayerId
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if request.auth != null
        && (myPlayerId() == recipientPlayerId || myPlayerId() == senderPlayerId);
    }

    match /friendLinks/{pairKey} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId in resource.data.players;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId == request.resource.data.recipientId
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.recipientId)/incoming/$(request.resource.data.requesterId)).data.status == 'accepted';
      allow update: if false;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/publicIdentity/main).data.playerId in resource.data.players;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterPlayerId == myPlayerId();
      allow read, update, delete: if isAdmin();
    }


    // v6.4-v6.5 global events / world boss.
    // Event definitions are written only by administrators.
    match /globalEvents/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /globalEvents/{eventId}/contributions/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && myPlayerId() == playerId
        && request.resource.data.playerId == playerId
        && request.resource.data.points >= 0
        && request.resource.data.integrityStatus == 'client_checked';
      allow delete: if request.auth != null && (myPlayerId() == playerId || isAdmin());
    }

    // v4.69: raw daily records are NOT published here.
    // Only anonymized aggregate counts used by GLOBAL ANALYTICS are stored.
    match /analyticsContributions/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                   && request.auth.uid == userId;
    }
  }
}
